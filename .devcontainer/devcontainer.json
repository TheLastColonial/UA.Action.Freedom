{
  "name": "freedom-dev",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "username": "vscode", "installZsh": false },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },
  "remoteUser": "vscode",
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1", "DOTNET_NOLOGO": "1" },
  "customizations": {
    "vscode": { "extensions": ["ms-dotnettools.csdevkit", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"] }
  },
  "postCreateCommand": "dotnet restore UA.Action.Freedom.slnx"
}
