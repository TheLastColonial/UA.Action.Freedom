# Keep NSwag-generated client code stable across Windows/Linux checkouts and CI.
# The generator emits LF; pin it so core.autocrlf cannot renormalise the diff.
src/HMRC.GVMS/Generated/** text eol=lf
src/HMRC.PushPullNotifications/Generated/** text eol=lf

# Runs as a container entrypoint: a CRLF checkout on Windows would make /bin/sh fail on it.
*.sh text eol=lf
