@startuml Containers | UA Action Freedom

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!define AzurePuml https://raw.githubusercontent.com/plantuml-stdlib/Azure-PlantUML/release/2-2/dist

!includeurl AzurePuml/AzureCommon.puml
!includeurl AzurePuml/AzureC4Integration.puml

!includeurl AzurePuml/Containers/AzureContainerApp.puml
!includeurl AzurePuml/Compute/AzureFunction.puml

!includeurl AzurePuml/Databases/AzureSqlDatabase.puml

!includeurl AzurePuml/Storage/AzureQueueStorage.puml
!includeurl AzurePuml/Storage/AzureBlobStorage.puml

!includeurl AzurePuml/Identity/AzureActiveDirectoryB2C.puml
!includeurl AzurePuml/Security/AzureKeyVault.puml
!includeurl AzurePuml/DevOps/AzureApplicationInsights.puml

title Containers | UA Action Freedom\nTarget state on Azure — every component sits on a permanent free allowance or scales to zero.\nPerson-to-person and person-to-third-party interactions are shown on the System Context diagram.

Person_Ext(guard, "Border Guard", "A person who represents a country's border guards")
Person_Ext(driver, "Driver", "A person who drives vehicles")

System_Ext(github, "GitHub", "Source, CI/CD and container registry (GitHub Actions + ghcr.io, free for the repo)")
System_Ext(email, "Email / SMS Provider", "Azure Communication Services — pay-per-message, no standing charge")

Enterprise_Boundary(hmrc, "HMRC") {
    System_Ext(hmrc_goods_api, "Goods Movement System Haulier API", "API for the UK Government's Goods Movement System", $link="https://developer.service.hmrc.gov.uk/api-documentation/docs/api/service/goods-movement-system-haulier-api/1.0/oas/page")
    System_Ext(hmrc_notifications, "Push Pull Notifications API", "API for the UK Government's Notifications for asyncronous communication", $link="https://developer.service.hmrc.gov.uk/api-documentation/docs/api/service/push-pull-notifications-api/1.0/oas/page")
}

Enterprise_Boundary(ua_action, "UA Action") {

    Person(administrator, "Administrator", "A person who manages access and roles")
    Person(ground_officer, "Ground Officer", "A person who connects with local authorities to coordinate convoys and requests for aid")
    Person(purchaser, "Purchaser", "A person who manages procurement and supplies for convoys")
    Person(loader, "Loader", "A person who loads cargo onto vehicles and verifies donations")
    Person(dispatcher, "Dispatcher", "A person who dispatches vehicles and manages paperwork for a convoy")

    AzureActiveDirectoryB2C(identity, "Identity Provider", "Microsoft Entra External ID", "Sign-in, MFA and app roles for staff and volunteers. Free up to 50,000 monthly active users")

    System(website, "Public Website", "Azure Static Web Apps (Free tier) — information about the organisation, donation sheets and driver applications")

    System_Boundary(freedom, "Freedom") {

        Container(edge, "Edge", "Cloudflare Free", "DNS, TLS termination, CDN, DDoS protection and managed WAF rules in front of the application. Free tier — replaces Azure Front Door, which carries a fixed monthly charge")

        AzureContainerApp(app, "Freedom Application", "ASP.NET Core 10 on Azure Container Apps (Consumption)", "Single deployable serving both the operator UI and its JSON API. Scales 0..N; the monthly free grant of vCPU-seconds and requests covers a convoy cycle")

        AzureFunction(customs_worker, "Customs Worker", "Azure Functions (Consumption, .NET isolated)", "Queue-triggered: submits Goods Movement References to HMRC. Timer-triggered: polls HMRC for outcomes while any GMR is in flight, then falls idle")

        AzureQueueStorage(work_queue, "Customs Work Queue", "Azure Queue Storage", "Durable hand-off for GMR submissions and refreshes, with a poison queue for failed attempts")

        AzureSqlDatabase(db, "Freedom Database", "Azure SQL Database (Serverless, free offer, auto-pause)", "Convoys, vehicles, manifests, boxes, people and roles. Sensitive receiver detail is held in a separate, restricted schema")

        AzureBlobStorage(documents, "Document Store", "Azure Blob Storage (Cool, private)", "One storage account holding manifests/, gmr/ and elo/ prefixes. No public access; downloads issued as short-lived user-delegation SAS")

        AzureKeyVault(vault, "Secret Store", "Azure Key Vault (Standard, per-operation billing)", "HMRC OAuth client credentials and the ASP.NET Core data-protection master key. No standing charge")

        AzureApplicationInsights(telemetry, "Telemetry", "Application Insights + Log Analytics", "Traces, metrics and audit events. Sampling on and a daily ingestion cap set to stay inside the 5 GB/month free allowance")
    }
}

' --- Operators reach the application through the edge ---
Rel_D(dispatcher, edge, "Plans convoys, builds manifests, requests GMR and ELO", "HTTPS")
Rel_D(loader, edge, "Confirms donation contents, weighs and validates boxes", "HTTPS")
Rel_D(purchaser, edge, "Records sourced vehicles and supplies", "HTTPS")
Rel_D(ground_officer, edge, "Raises requests for aid, confirms receipt", "HTTPS")
Rel_U(guard, edge, "Scans manifest QR code to verify a load", "HTTPS, anonymous single-manifest token")

Rel_D(administrator, identity, "Manages accounts, roles and MFA policy")

' --- Inside Freedom ---
Rel_D(edge, app, "Routes requests", "HTTPS")
Rel(app, identity, "Authenticates users, authorises by app role", "OpenID Connect")
Rel_D(app, db, "Reads from and writes to", "Entra auth, managed identity")
Rel_D(app, documents, "Saves and serves Manifest and ELO documents", "managed identity")
Rel_D(app, work_queue, "Queues GMR submissions and refreshes", "managed identity")
Rel(app, vault, "Reads secrets", "managed identity")
Rel(app, telemetry, "Emits traces, metrics and audit events")

Rel_D(work_queue, customs_worker, "Triggers")
Rel_D(customs_worker, db, "Writes GMR status against the Manifest", "managed identity")
Rel_D(customs_worker, documents, "Saves GMR document", "managed identity")
Rel(customs_worker, vault, "Reads HMRC credentials", "managed identity")
Rel(customs_worker, telemetry, "Emits traces and metrics")

' --- Outbound to HMRC: pull only, no inbound endpoint ---
Rel_R(customs_worker, hmrc_goods_api, "Submits Goods Movement References", "HTTPS, OAuth 2.0")
Rel_R(customs_worker, hmrc_notifications, "Polls for outcomes", "HTTPS — pull, no inbound endpoint exposed")
Rel_D(hmrc_goods_api, hmrc_notifications, "Publishes Goods Movement Reference outcomes")

' --- Notifications out ---
Rel_R(app, email, "Sends convoy allocation and manifest notifications")
Rel_D(email, driver, "Notifies of convoy allocation and provides the manifest link")

' --- Public website feeds Freedom (proposed — see docs/recommendations.md) ---
Rel_L(website, app, "Submits driver applications and donation declarations", "HTTPS, rate-limited public endpoint")

' --- Delivery pipeline ---
Rel_L(github, app, "Deploys container image", "GitHub Actions, OIDC federated credential")
Rel_L(github, customs_worker, "Deploys function package", "GitHub Actions, OIDC federated credential")

SHOW_LEGEND()

@enduml
