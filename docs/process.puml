@startuml Manifest Creation Process

title Manifest Creation Process

start

group Administration {
    
    :Truck List Created;
    :Truck List Published;
    :Manifest Proposed;
    :Manifest Approved;

    fork
        :Generate GMR;
    fork again
        :Generate ELO;
    end fork

}

group Execution {

    :Prepare Boxes;
    :Load Trucks;
    :Truck Departs;
    
}

group Stock Ordering {

    fork
        :Update Truck Kit Stock;
    fork again
        :Update Merchandise Stock;
    end fork

}

end

@enduml