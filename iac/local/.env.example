# Copy to .env before the first `docker compose up`. .env is gitignored.
#
# Nothing in here is a real secret — it is the local stand-in for what Azure Key Vault
# holds in the target design (docs/recommendations.md 4.2). Never reuse these values
# anywhere that is reachable from outside your machine.

# --- Freedom Database (stands in for Azure SQL) ---
# SQL Server rejects weak passwords at startup: 8+ chars, three of upper/lower/digit/symbol.
MSSQL_SA_PASSWORD=Local_Freedom_Dev_1

# The application connects as freedom_app, not as sa. sa is sysadmin and bypasses
# permission checks, which would make the DENY on the sensitive schema meaningless
# (docs/recommendations.md 4.4). freedom_sensitive is the Ground Officer path and the only
# identity that can read a Ukrainian delivery address.
FREEDOM_APP_DB_PASSWORD=Local_Freedom_App_1
FREEDOM_SENSITIVE_DB_PASSWORD=Local_Freedom_Sensitive_1

# --- Identity Provider (stands in for Microsoft Entra External ID) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The client secret OpenTofu assigns to the Freedom application's OIDC client.
# The app reads it as Oidc__ClientSecret; tofu writes it into Keycloak.
OIDC_CLIENT_SECRET=local-freedom-client-secret

# --- HMRC OAuth (stands in for the Key Vault-held client credentials) ---
# WireMock accepts anything; these exist so the credential flow has something to carry.
HMRC_CLIENT_ID=local-hmrc-client-id
HMRC_CLIENT_SECRET=local-hmrc-client-secret

# --- Customs (what HMRC needs that the manifest does not carry) ---
# The charity's EORI number, and HMRC's identifier for the crossing the convoys use.
CUSTOMS_HAULIER_EORI=GB123456789000
CUSTOMS_ROUTE_ID=20000

# The Push Pull Notifications box the Customs Worker polls for GMR outcomes.
HMRC_PPNS_BOX_ID=1c5b9365-18a6-55a5-99c9-83a091ac7f26

# --- French customs ELO (stands in for the Key Vault-held operator credentials) ---
# The ELO API declares no security scheme, so the bearer token is an ordinary per-call header
# obtained by the OAuth2 password grant. WireMock checks none of it, so ELO_TOKEN_ENDPOINT is
# left empty and the worker sends ELO_STATIC_TOKEN instead — standing up an OAuth2 server to
# mint a credential nobody verifies would add a container and prove nothing. Set the endpoint
# and the four credentials when pointing at the real certification environment
# (https://api-moa.douane.gouv.fr/sibrexit/) — see docs/schemas/edi/onboarding.md.
ELO_TOKEN_ENDPOINT=
ELO_CLIENT_ID=local-elo-client-id
ELO_CLIENT_SECRET=local-elo-client-secret
ELO_USERNAME=local-elo-operator
ELO_PASSWORD=local-elo-password
ELO_STATIC_TOKEN=local-development-token

# --- ICS2 (Entry Summary Declaration) ---
# There is nothing to configure for talking to ICS2, because Freedom does not: the Shared Trader
# Interface speaks eDelivery AS4, which needs an always-on inbound access point, an eIDAS sealing
# certificate registered in UUM&DS and a passed self-conformance run — see
# docs/schemas/ics2/onboarding.md. A Ground Officer files in the EU Customs Trader Portal and a
# Dispatcher records the MRN with PUT /manifests/{id}/ens. An envelope will not be requested, and
# a manifest will not be approved, until one exists.
#
# These two are what the filing sheet cannot derive from the manifest or the convoy.
ENS_CONSIGNOR_NAME=Ukrainian Action
ENS_OFFICE_OF_FIRST_ENTRY=FR620001

# --- Host ports ---
# Change these if something else on the machine already owns them.
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
KEYCLOAK_PORT=8081
WIREMOCK_PORT=8082
MAILPIT_UI_PORT=8025
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MSSQL_PORT=1433
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
