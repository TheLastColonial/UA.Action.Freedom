{
  "uid": "freedom-access-security",
  "title": "Access & Sensitive Data",
  "description": "Aggregate view of who is being let in and turned away, and how often Ukrainian delivery addresses are looked up. Counts only, by design: never principals, receiver references, addresses or reasons. The receiver-detail audit table in the database is the source of truth for who resolved which address and why.",
  "tags": [
    "freedom",
    "security",
    "sensitive-data",
    "key-feature"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 41,
  "links": [
    {
      "title": "Freedom dashboards",
      "type": "dashboards",
      "tags": [
        "freedom"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore traces (Tempo)",
      "type": "link",
      "icon": "external link",
      "url": "/explore?orgId=1&left=%7B%22datasource%22:%22tempo%22%7D",
      "targetBlank": true
    },
    {
      "title": "Explore logs (Loki)",
      "type": "link",
      "icon": "external link",
      "url": "/explore?orgId=1&left=%7B%22datasource%22:%22loki%22%7D",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Delivery-address lookups",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Address lookups (in range)",
      "description": "Ground Officer resolves of a receiver's delivery address — the only way to read one. Every one is also written to the audit table in the same transaction.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(freedom_receiver_detail_resolves_total{job=\"freedom-app\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
