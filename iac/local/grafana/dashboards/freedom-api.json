          },
          "refId": "A",
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!~\"/health.*\", http_response_status_code=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}} {{http_route}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 12,
      "title": "Authentication & authorization (built-in ASP.NET Core metrics)",
