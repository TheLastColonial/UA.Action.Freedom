          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!~\"/health.*\", http_response_status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!~\"/health.*\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "4xx / 5xx by route and status",
      "description": "Where the errors are. 409 = a business conflict (frozen manifest, vehicle already assigned); see the handler outcomes below for which.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
