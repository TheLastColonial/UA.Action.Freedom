          },
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!~\"/health.*\", http_response_status_code=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!~\"/health.*\", http_response_status_code=~\"3..\"}[$__rate_interval]))",
          "legendFormat": "3xx"
        },
        {
          "datasource": {
            "type": "prometheus",
