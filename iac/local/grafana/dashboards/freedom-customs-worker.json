      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (kind) (freedom_queue_depth{job=~\"$service\", queue=\"customs-work\"})",
          "legendFormat": "{{kind}}"
        }
      ]
    },
