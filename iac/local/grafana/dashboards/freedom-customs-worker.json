{
  "uid": "freedom-customs-worker",
  "title": "Customs Worker",
  "description": "The Customs Worker: the customs work queue, GMR submissions to HMRC, dead-letters, HMRC outcome notifications, loop heartbeats, logs and traces. Approved manifests reach it through the customs-work queue; it submits to HMRC GVMS and polls Push Pull Notifications for the outcome.",
  "tags": [
    "freedom",
    "worker",
    "customs",
    "hmrc"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 41,
  "links": [
    {
      "title": "Freedom dashboards",
      "type": "dashboards",
      "tags": [
        "freedom"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore traces (Tempo)",
      "type": "link",
      "icon": "external link",
      "url": "/explore?orgId=1&left=%7B%22datasource%22:%22tempo%22%7D",
      "targetBlank": true
    },
    {
      "title": "Explore logs (Loki)",
      "type": "link",
      "icon": "external link",
      "url": "/explore?orgId=1&left=%7B%22datasource%22:%22loki%22%7D",
      "targetBlank": true
    },
    {
      "title": ".NET runtime for this service",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/freedom-dotnet?var-service=${service}",
      "targetBlank": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "hide": 2,
        "query": "freedom-customs-worker",
        "current": {
          "text": "freedom-customs-worker",
          "value": "freedom-customs-worker",
          "selected": true
        },
        "options": [
          {
            "text": "freedom-customs-worker",
            "value": "freedom-customs-worker",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Health at a glance",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Waiting to be processed",
      "description": "Approximate messages on the work queue, including any being processed right now. Read by the worker every 30s, so it lags by up to that. A sustained non-zero value means the worker is not keeping up or is stuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(freedom_queue_depth{job=~\"$service\", queue=\"customs-work\", kind=\"work\"})"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Poison queue",
      "description": "Messages that failed in a way retrying will not fix and were parked. Anything above zero needs a person: the reason is in the worker log line 'Moved work item ... to the poison queue' and in the dead-letter reasons below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(freedom_queue_depth{job=~\"$service\", queue=\"customs-work\", kind=\"poison\"})"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Oldest waiting message",
      "description": "Age of the message at the head of the work queue. Zero means the queue is empty. A message that keeps getting older is being retried (see redeliveries) or is not being picked up at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(freedom_queue_oldest_message_age_seconds{job=~\"$service\", queue=\"customs-work\", kind=\"work\"}) or (max(freedom_queue_depth{job=~\"$service\", queue=\"customs-work\", kind=\"work\"}) * 0)"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Submit loop — last success",
      "description": "Seconds since the 'drain' loop last completed a pass (empty passes count, so this is a heartbeat rather than a throughput measure). Turns amber/red when the loop is stuck, crashing every pass, or dead. A value of about a year means it has not succeeded once since the process started.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "time() - max(freedom_worker_loop_last_success_seconds{job=~\"$service\", loop=\"drain\"})"
        }
      ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Outcomes loop — last success",
      "description": "Seconds since the 'outcomes' loop last completed a pass (empty passes count, so this is a heartbeat rather than a throughput measure). Turns amber/red when the loop is stuck, crashing every pass, or dead. A value of about a year means it has not succeeded once since the process started. The customs 'outcomes' loop currently fails on every poll because HMRC.PushPullNotifications cannot deserialise a notification (known bug — CLAUDE.md, iac/README.md 'Known issues').",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(time() - max(freedom_worker_loop_last_success_seconds{job=~\"$service\", loop=\"outcomes\"})) or on() vector(31536000)"
        }
      ]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Loop errors (in range)",
      "description": "Passes of either loop that ended in an unhandled error. Should be zero. Split by loop further down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(freedom_worker_loop_errors_total{job=~\"$service\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Queue",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Queue depth",
      "description": "Approximate depth of the work queue and its poison queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "poison"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "work"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
