    {
      "type": "timeseries",
      "id": 13,
      "title": "Redeliveries",
      "description": "Messages picked up for at least the second time. Queue Storage never gives up on a message by itself, so a message that fails forever shows up here forever (until its 7-day expiry silently drops it).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
