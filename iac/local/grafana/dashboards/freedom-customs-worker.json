    {
      "type": "timeseries",
      "id": 15,
      "title": "Submissions by outcome",
      "description": "accepted = HMRC took it. rejected = a 4xx (the submission itself was refused; dead-lettered). error = anything else (timeout, 5xx, dropped connection); the message stays on the queue and is retried.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
