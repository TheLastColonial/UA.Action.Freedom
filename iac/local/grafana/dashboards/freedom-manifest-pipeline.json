    {
      "type": "timeseries",
      "id": 12,
      "title": "Queued by the API vs completed by the worker",
      "description": "The two lines for a queue should track each other, the second slightly behind. A widening gap is a backlog or a worker that is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
