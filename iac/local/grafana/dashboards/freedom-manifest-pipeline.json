          "legendFormat": "queued — {{queue}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (queue) (increase(freedom_queue_messages_processed_total{outcome=\"completed\"}[$__rate_interval]))",
          "legendFormat": "completed — {{queue}}"
        }
      ]
    },
