      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (stage) (increase(freedom_manifest_approve_partial_failures_total{job=\"freedom-app\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 11,
      "title": "Queues — enqueued, waiting, done",
