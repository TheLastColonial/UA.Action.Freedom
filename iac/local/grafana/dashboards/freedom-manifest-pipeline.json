    },
    {
      "type": "table",
      "id": 18,
      "title": "Worker loop heartbeats",
      "description": "Seconds since each worker loop last completed a pass. A missing row means that loop has never succeeded — currently the customs 'outcomes' loop, because of the documented HMRC.PushPullNotifications deserialisation bug.",
      "datasource": {
        "type": "prometheus",
