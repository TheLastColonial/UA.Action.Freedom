      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (kind) (freedom_queue_depth{job=~\"$service\", queue=\"manifest-documents\"})",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
