        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(freedom_queue_message_age_seconds_bucket{job=~\"$service\", queue=\"manifest-documents\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(freedom_queue_message_age_seconds_bucket{job=~\"$service\", queue=\"manifest-documents\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Redeliveries",
      "description": "Messages picked up for at least the second time. Queue Storage never gives up on a message by itself, so a message that fails forever shows up here forever (until its 7-day expiry silently drops it).",
