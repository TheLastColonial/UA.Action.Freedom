<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8625;CS8765;CS0472;CS1573</NoWarn>
  </PropertyGroup>

  <!-- Published to GitHub Packages by the `nuget` CI job. Version is supplied at pack
       time (-p:PackageVersion=), so there is deliberately no <Version> here. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EDI.ELO</PackageId>
    <Title>French customs ELO (EDI) client</Title>
    <Description>Generated .NET client for the French customs ELO (Enveloppe Logistique Obligatoire) EDI API.</Description>
    <PackageTags>edi;elo;customs;france;brexit</PackageTags>
    <Authors>Alex Woodward</Authors>
    <Company>Ukrainian Action</Company>
    <Product>UA.Action.Freedom</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/TheLastColonial/UA.Action.Freedom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheLastColonial/UA.Action.Freedom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
