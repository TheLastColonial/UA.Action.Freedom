{
  "name": "ua-action-freedom-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-query": "^5.59.0",
    "oidc-client-ts": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-oidc-context": "^3.2.0",
    "react-router-dom": "^7.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@tanstack/eslint-plugin-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-testing-library": "^7.1.0",
    "msw": "^2.6.0",
    "prettier": "^3.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.16.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vitest-browser-react": "^1.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
